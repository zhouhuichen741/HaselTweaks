<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- Project settings -->
  <PropertyGroup>
    <Name>HaselTweaks</Name>
    <Version>50.0.4</Version>
    <Author>Haselnussbomber,cyf5119(汉化),zhouhuichen741(汉化&amp;本地化维护)</Author>
    <RepoUrl>https://github.com/zhouhuichen741/HaselTweaks</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/zhouhuichen741/dalamud-plugins/master/plugins/HaselTweaks/icon.png</IconUrl>
    <Punchline>一系列生活质量调整（在线安装 Only）</Punchline>
    <Description>继续调整</Description>
    <CanUnloadAsync>true</CanUnloadAsync>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Build settings -->
  <PropertyGroup>
    <OutputPath>..\bin\</OutputPath>
    <DefineConstants>$(DefineConstants);AUTOCTOR_EMBED_ATTRIBUTES</DefineConstants>
    <NoWarn>$(NoWarn);Dalamud001;CA1873</NoWarn>
  </PropertyGroup>

  <!-- Dalamud.NET.Sdk settings -->
  <PropertyGroup>
    <Use_Dalamud_Newtonsoft_Json>false</Use_Dalamud_Newtonsoft_Json>
    <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
  </PropertyGroup>

  <!-- Assets -->
  <ItemGroup>
    <None Include="Assets\Logo.png" Link="Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Translations.json" Link="$(AssemblyName).Translations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSES.md" Link="LICENSES.md" CopyToOutputDirectory="PreserveNewest" />

    <None Condition="'$(Configuration)' == 'Debug'" Include="Assets\Icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- References to Dalamud dependencies -->
  <ItemGroup>
    <Reference Include="TerraFX.Interop.Windows" Private="false" />
    <Reference Include="Iced" Private="false" />
  </ItemGroup>

  <!-- NuGet dependencies -->
  <ItemGroup>
    <PackageReference Include="AutoCtor" Version="4.0.2" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- FFXIVClientStructs -->
  <PropertyGroup>
    <InteropGenerator_InteropNamespace>$(AssemblyName)</InteropGenerator_InteropNamespace>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="InteropGenerator_InteropNamespace" />
    <ProjectReference Include="..\FFXIVClientStructs\InteropGenerator\InteropGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FFXIVClientStructs\FFXIVClientStructs\FFXIVClientStructs.csproj" Private="True" />
    <ProjectReference Include="..\FFXIVClientStructs\InteropGenerator.Runtime\InteropGenerator.Runtime.csproj" Private="True" />
  </ItemGroup>

  <Target Name="DeleteCSXmlDocs" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and Exists('$(TargetDir)FFXIVClientStructs.xml')">
    <Delete Files="$(TargetDir)FFXIVClientStructs.xml" />
  </Target>

  <!-- HaselCommon -->
  <ItemGroup>
    <ProjectReference Include="..\HaselCommon\HaselCommon\HaselCommon.csproj" />
    <ProjectReference Include="..\HaselCommon\HaselCommon.Generators\HaselCommon.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- BannedApiAnalyzers -->
  <ItemGroup>
    <AdditionalFiles Include="..\HaselCommon\HaselCommon\BannedSymbols.CustomCS.txt" />
  </ItemGroup>
</Project>
